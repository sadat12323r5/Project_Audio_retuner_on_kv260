/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */
#include "xaxidma.h"
#include "xparameters.h"
#include "xil_cache.h"
#include "sleep.h"
#include "ff.h"             // xilffs / FatFs
#include <stdint.h>
#include <stdio.h>

/*** DMA device ***/
#define DMA_DEV_ID              XPAR_AXIDMA_0_DEVICE_ID

/*** Audio / file format ***/
#define FS                      48000      // sample rate (Hz) – set to your LRCLK
#define CHANNELS                1          // mono
#define MIC_BITS                18         // useful MSBs from the I2S mic
#define OUT_BITS                16         // write 16-bit PCM in the WAV

/*** Capture sizing ***/
#define BURST_SAMPLES           1024       // per DMA transfer (power of 2 is nice)
#define BYTES_PER_SAMPLE        4          // PL streams 32-bit words
#define BURST_BYTES             (BURST_SAMPLES * BYTES_PER_SAMPLE)

#define SECONDS_TO_RECORD       3          // speak for ~3 seconds
#define TOTAL_SAMPLES           (FS * SECONDS_TO_RECORD)

/*** Globals ***/
static XAxiDma AxiDma;
static uint32_t rx32[BURST_SAMPLES] __attribute__((aligned(64)));
static int16_t  pcm16[BURST_SAMPLES];

/*** 24-bit-ish mic sample (left-justified in 32)  16-bit PCM ***/
static inline int16_t to_pcm16(uint32_t w)
{
    // Treat as signed; keep top 16 bits. For 18-bit mic: shift right by 2.
    int32_t s = (int32_t)w;
    return (int16_t)(s >> (MIC_BITS - OUT_BITS));
}

/*** 44-byte WAV header ***/
static void wav_header(uint8_t *h, uint32_t nsamples, uint32_t fs,
                       uint16_t bits, uint16_t ch)
{
    uint32_t byteRate  = fs * ch * (bits/8);
    uint16_t blockAlign= ch * (bits/8);
    uint32_t dataSize  = nsamples * blockAlign;
    uint32_t riffSize  = 36 + dataSize;

    h[0]='R';h[1]='I';h[2]='F';h[3]='F';
    h[4]= riffSize     &255; h[5]=(riffSize>>8)&255; h[6]=(riffSize>>16)&255; h[7]=(riffSize>>24)&255;
    h[8]='W';h[9]='A';h[10]='V';h[11]='E';
    h[12]='f';h[13]='m';h[14]='t';h[15]=' ';
    h[16]=16; h[17]=0; h[18]=0; h[19]=0;          // fmt chunk size
    h[20]=1;  h[21]=0;                            // PCM
    h[22]=ch; h[23]=0;                            // channels
    h[24]= fs        &255; h[25]=(fs>>8)&255; h[26]=(fs>>16)&255; h[27]=(fs>>24)&255;
    h[28]= byteRate  &255; h[29]=(byteRate>>8)&255; h[30]=(byteRate>>16)&255; h[31]=(byteRate>>24)&255;
    h[32]= blockAlign&255; h[33]=(blockAlign>>8)&255;
    h[34]= bits      &255; h[35]=(bits>>8)&255;
    h[36]='d';h[37]='a';h[38]='t';h[39]='a';
    h[40]= dataSize  &255; h[41]=(dataSize>>8)&255; h[42]=(dataSize>>16)&255; h[43]=(dataSize>>24)&255;
}

/*** open WAV on SD and write placeholder header ***/
static int sd_open_wav(FIL *fp, const char *path,
                       uint32_t nsamples, uint32_t fs,
                       uint16_t bits, uint16_t ch)
{
    FATFS fs0; FRESULT fr;
    fr = f_mount(&fs0, "0:", 1);
    if (fr != FR_OK) { xil_printf("f_mount error %d\r\n", fr); return -1; }

    fr = f_open(fp, path, FA_CREATE_ALWAYS | FA_WRITE);
    if (fr != FR_OK) { xil_printf("f_open error %d\r\n", fr); return -1; }

    UINT bw; uint8_t hdr[44];
    wav_header(hdr, nsamples, fs, bits, ch);
    f_write(fp, hdr, sizeof(hdr), &bw);
    if (bw != sizeof(hdr)) { xil_printf("header write failed\r\n"); f_close(fp); return -1; }
    return 0;
}

/*** patch the header with the true sample count ***/
static void sd_fix_header(FIL *fp, uint32_t nsamples, uint32_t fs,
                          uint16_t bits, uint16_t ch)
{
    UINT bw; uint8_t hdr[44];
    wav_header(hdr, nsamples, fs, bits, ch);
    f_lseek(fp, 0);
    f_write(fp, hdr, sizeof(hdr), &bw);
}

static void sd_probe(void) {
    FATFS fs;
    FRESULT fr;

    xil_printf("Probing SD...\r\n");

    fr = f_mount(&fs, "0:", 1);
    xil_printf("f_mount 0: -> %d\r\n", fr);

    fr = f_mount(&fs, "1:", 1);
    xil_printf("f_mount 1: -> %d\r\n", fr);
}

int main(void)
{
    printf("Audio capture start...\n");

    // -------- Init DMA (simple mode) --------
    XAxiDma_Config *Cfg = XAxiDma_LookupConfig(DMA_DEV_ID);
    if (!Cfg) {
        printf("No DMA config found.\n");
        return XST_FAILURE;
    }
    int status = XAxiDma_CfgInitialize(&AxiDma, Cfg);
    if (status != XST_SUCCESS) {
        printf("DMA init failed.\n");
        return status;
    }
    if (XAxiDma_HasSg(&AxiDma)) {
        printf("Scatter-Gather DMA detected; expecting Simple mode.\n");
        return XST_FAILURE;
    }

    // -------- Open WAV on SD --------
    xil_printf("Opening 1:/rec.wav ...\r\n");
    FIL f; UINT bw;
    if (sd_open_wav(&f, "1:/rec.wav", TOTAL_SAMPLES, FS, OUT_BITS, CHANNELS) != 0) {
        return XST_FAILURE;
    }

    printf("Recording %d s @ %d Hz… speak now!\n", SECONDS_TO_RECORD, FS);

    uint32_t samples_written = 0;
    while (samples_written < TOTAL_SAMPLES) {
        // 1) kick S2MM for one burst
        Xil_DCacheFlushRange((UINTPTR)rx32, BURST_BYTES);
        status = XAxiDma_SimpleTransfer(
            &AxiDma,
            (UINTPTR)rx32,
            BURST_BYTES,
            XAXIDMA_DEVICE_TO_DMA
        );
        if (status != XST_SUCCESS) {
            printf("DMA transfer setup failed.\n");
            break;
        }

        // 2) wait for completion
        while (XAxiDma_Busy(&AxiDma, XAXIDMA_DEVICE_TO_DMA)) { /* tight poll ok */ }

        // 3) see fresh data
        Xil_DCacheInvalidateRange((UINTPTR)rx32, BURST_BYTES);

        // 4) convert to 16-bit PCM
        for (int i = 0; i < BURST_SAMPLES; ++i) {
            pcm16[i] = to_pcm16(rx32[i]);
        }

        // 5) write to SD (respect final partial chunk)
        uint32_t chunk = BURST_SAMPLES;
        if (samples_written + chunk > TOTAL_SAMPLES)
            chunk = TOTAL_SAMPLES - samples_written;

        f_write(&f, pcm16, chunk * sizeof(int16_t), &bw);
        if (bw != chunk * sizeof(int16_t)) {
            xil_printf("f_write short (%u vs %u)\r\n", (unsigned)bw, (unsigned)(chunk*sizeof(int16_t)));
            break;
        }

        samples_written += chunk;
    }

    // Patch header with the actual sample count and close
    sd_fix_header(&f, samples_written, FS, OUT_BITS, CHANNELS);
    f_close(&f);

    printf("Saved 0:/rec.wav (%u samples). Pull SD and play it.\n", samples_written);
    return 0;
}
