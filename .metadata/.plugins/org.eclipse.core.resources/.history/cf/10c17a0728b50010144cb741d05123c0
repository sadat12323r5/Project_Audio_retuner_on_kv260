/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */
#include "xaxidma.h"
#include "xparameters.h"
#include "xil_cache.h"
#include "sleep.h"
#include <stdint.h>
#include <stdio.h>

// DMA config
#define DMA_DEV_ID       XPAR_AXIDMA_0_DEVICE_ID

// Capture parameters
#define N_SAMPLES        1024
#define BYTES_PER_SAMPLE 4
#define RX_BYTES         (N_SAMPLES * BYTES_PER_SAMPLE)

static XAxiDma AxiDma;
static volatile char audio_rx_buf[RX_BYTES] __attribute__((aligned(64)));

int main()
{
    int status;
    printf("Audio capture start...\n");

    // -----------------------------
    // 1. Initialise AXI DMA
    // -----------------------------
    XAxiDma_Config *Cfg = XAxiDma_LookupConfig(DMA_DEV_ID);
    if (!Cfg) {
        printf("No DMA config found.\n");
        return XST_FAILURE;
    }

    status = XAxiDma_CfgInitialize(&AxiDma, Cfg);
    if (status != XST_SUCCESS) {
        printf("DMA init failed.\n");
        return status;
    }

    if (XAxiDma_HasSg(&AxiDma)) {
        printf("Scatter-Gather DMA detected; expecting Simple mode.\n");
        return XST_FAILURE;
    }

    // -----------------------------
    // 2. Prepare buffer
    // -----------------------------
    Xil_DCacheFlushRange((UINTPTR)audio_rx_Buf, RX_BYTES);

    // -----------------------------
    // 3. Start S2MM transfer
    // -----------------------------
    printf("Starting S2MM transfer...\n");
    status = XAxiDma_SimpleTransfer(
        &AxiDma,
        (UINTPTR)audio_rx_Buf,
        RX_BYTES,
        XAXIDMA_DEVICE_TO_DMA
    );

    if (status != XST_SUCCESS) {
        printf("DMA transfer setup failed.\n");
        return status;
    }

    // -----------------------------
    // 4. Wait for DMA to finish
    // -----------------------------
    while (XAxiDma_Busy(&AxiDma, XAXIDMA_DEVICE_TO_DMA)) {
        usleep(1000); // small poll delay
    }

    // -----------------------------
    // 5. Invalidate cache (to see fresh data)
    // -----------------------------
    Xil_DCacheInvalidateRange((UINTPTR)audio_rx_Buf, RX_BYTES);

    // -----------------------------
    // 6. Print first few samples
    // -----------------------------
    printf("DMA done! First 16 samples:\n");
    for (int i = 0; i < 16; i++) {
        uint32_t word = ((uint32_t*)rxBuf)[i];
        printf("[%4d] 0x%08X\n", i, word);
    }

    printf("Capture complete.\n");

    return 0;
}

