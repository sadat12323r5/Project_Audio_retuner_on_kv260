# Text files: keep LF in repo and in working tree
*.c     text eol=lf
*.h     text eol=lf
*.tcl   text eol=lf
*.ld    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf

# Vivado/Vitis project files
*.xpr   text eol=lf
*.xsa   binary
*.bit   binary
*.bin   binary
*.elf   binary

# Logs/journals stay ignored by .gitignore, but if ever added:
*.log   -text
*.jou   -text
*.str   -text
